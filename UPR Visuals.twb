            </column>
            <column caption='FundingVal' datatype='integer' name='[Calculation_2926776858838511617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Round (Support)], [Country (Support)], [NS (Support)] : SUM(IF [Attribute (Support)] = &quot;Total&quot; THEN [Value (Support)] ELSE 0 END) }' />
            </column>
            <column caption='Funding Reported' datatype='string' name='[Calculation_2926776858840403970]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_2926776858838511617]) = 0 THEN &quot;&quot;&#13;&#10;ELSEIF SUM([Calculation_2926776858838511617]) &lt; 1000 THEN &#13;&#10;    STR(SUM([Calculation_2926776858838511617]))&#13;&#10;ELSEIF SUM([Calculation_2926776858838511617]) &lt; 1000000 THEN &#13;&#10;    STR(ROUND(SUM([Calculation_2926776858838511617])/1000, 0)) + &quot;,000&quot;&#13;&#10;ELSE &#13;&#10;    IF RIGHT(LEFT(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 2)), FIND(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), &quot;.&quot;) + 1), 2) = &quot;.0&quot; THEN &#13;&#10;        STR(INT(SUM([Calculation_2926776858838511617])/1000000)) + &quot;M&quot;&#13;&#10;    ELSEIF RIGHT(LEFT(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), FIND(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), &quot;.&quot;) + 2), 1) = &quot;0&quot; THEN &#13;&#10;        LEFT(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), FIND(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 2)), &quot;.&quot;) + 1) + &quot;M&quot;&#13;&#10;    ELSE &#13;&#10;        STR(INT(SUM([Calculation_2926776858838511617]) / 1000000)) + &quot;.&quot; + &#13;&#10;        LEFT(STR(INT((SUM([Calculation_2926776858838511617]) - (INT(SUM([Calculation_2926776858838511617]) / 1000000) * 1000000)) / 10000)), 1) + &quot;M&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
