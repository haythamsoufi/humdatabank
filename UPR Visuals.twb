      <column datatype='string' name='[Attribute]' role='dimension' type='nominal' />
      <column caption='Formatting' datatype='string' name='[Calculation_1114922436515717121]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;● &quot; + [Indicator] + CHAR(10) +&#13;&#10;&quot;...........................................................................................................................................................................................................................................................&quot;' />
      </column>
      <column caption='AdditionText2' datatype='string' name='[Calculation_121315738704105472]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_301741197660049409] = 0 THEN [Calculation_301741197663506435] ELSE &quot;, &quot; + [Calculation_301741197663506435]  END' />
      </column>
      <column caption='Display' datatype='string' name='[Calculation_1384575472523804672]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Value Formatted] = &quot;Yes&quot; THEN&#13;&#10;   [Indicator]&#13;&#10;END' />
      </column>
      <column caption='Total funding text' datatype='string' name='[Calculation_1541638503715168257]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_2926776858838511617]) = 0 THEN &quot;&quot; ELSE &#13;&#10;(IF LEFT(ATTR([Round (Support)]), 1) = &quot;P&quot; THEN &quot;Total Funding Requirement&quot; ELSE &quot;Total Funding Reported&quot; END) END' />
      </column>
      <column caption='Total funding text2' datatype='string' name='[Calculation_1541638503715901442]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_2926776858838511617]) = 0 THEN &quot;&quot; ELSE &quot;CHF&quot; END' />
      </column>
      <column caption='Funding Sources title' datatype='string' name='[Calculation_1541638503716933635]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([ValueNum]) = 0 THEN &quot;&quot; ELSE &quot;Funding Sources&quot; END' />
      </column>
      <column caption='PNS Table (Symbols)' datatype='string' name='[Calculation_1541638503749152772]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([Attribute (Support)]) = &quot;Total&quot; THEN NULL&#13;&#10;ELSEIF MIN([Attribute (Support)]) = &quot;Multilateral Support&quot; THEN &quot;✔&quot;&#13;&#10;ELSE &quot;⬤&quot; END' />
      </column>
      <column caption='EF Number' datatype='string' name='[Calculation_1552616030498045954]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Value] &lt;&gt; &quot;1&quot; THEN [Value] + CHAR(10) END' />
      </column>
      <column caption='Checkmark' datatype='string' name='[Calculation_173670115360649216]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Value Formatted] = &quot;Yes&quot;&#13;&#10;THEN &quot;✓&quot; &#13;&#10;END' />
      </column>
      <column caption='SP2 Subtitle' datatype='string' name='[Calculation_173670115376488449]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Number of people reached with&quot;' />
      </column>
      <column caption='Funding Requirement Value' datatype='integer' name='[Calculation_1742611646973620227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Round (Support)], [Country (Support)], [NS (Support)], [Year] : SUM(IF [Attribute (Support)] = &quot;Total&quot; THEN [Value (Support)] ELSE 0 END) }' />
      </column>
      <column caption='Funding Requirement' datatype='string' name='[Calculation_1742611646973833220]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_1742611646973620227]) = 0 THEN &quot;&quot;&#13;&#10;ELSEIF SUM([Calculation_1742611646973620227]) &lt; 1000 THEN&#13;&#10;    STR(SUM([Calculation_1742611646973620227]))&#13;&#10;ELSEIF SUM([Calculation_1742611646973620227]) &lt; 1000000 THEN&#13;&#10;    STR(ROUND(SUM([Calculation_1742611646973620227])/1000,0)) + &quot;,000&quot;&#13;&#10;ELSE&#13;&#10;    IF ROUND(SUM([Calculation_1742611646973620227])/1000000,1) == INT(SUM([Calculation_1742611646973620227])/1000000) THEN&#13;&#10;        STR(INT(SUM([Calculation_1742611646973620227])/1000000)) + &quot;M&quot;&#13;&#10;    ELSE&#13;&#10;        STR(ROUND(SUM([Calculation_1742611646973620227])/1000000,1)) + &quot;M&quot;&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='Logo circle' datatype='integer' name='[Calculation_1770759137780891648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Remainder_Numeric' datatype='real' name='[Calculation_1775262742023917570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='100 - FLOAT(REPLACE([Value Formatted], &quot;%&quot;, &quot;&quot;))' />
      </column>
      <column caption='Value_Numeric' datatype='real' name='[Calculation_1775262742027083780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(REPLACE([Value Formatted], &quot;%&quot;, &quot;&quot;))' />
      </column>
      <column caption='Value Not reported' datatype='string' name='[Calculation_1797780678625456129]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(SUM([ValueNum])) THEN &quot;Not reported&quot; else NULL END' />
      </column>
      <column caption='Round Filter' datatype='boolean' name='[Calculation_2093329466197032963]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Round] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Colours' datatype='string' name='[Calculation_2264466243873484804]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MAX([Attribute (Support)]) = &quot;Total&quot; THEN&#13;&#10;    &quot;Funding Reported&quot;&#13;&#10;ELSE&#13;&#10;    IF MAX([Value (Support)]) &gt; 0 THEN&#13;&#10;        MIN(IF [Value (Support)] &gt; 0 THEN [Attribute (Support)] END)&#13;&#10;    ELSE&#13;&#10;        NULL&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='Support Category' datatype='string' name='[Calculation_2264466243873804293]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Attribute (Support)] = &quot;Multilateral Support&quot; THEN &quot;Multilateral Support&quot; ELSE &quot;Bilateral Support&quot; END' />
      </column>
      <column caption='Value_Indicators' datatype='real' name='[Calculation_2688086072004980736]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [typeOfMeasurement] = &quot;YesNo&quot; or [typeOfMeasurement] = &quot;Percentage&quot; THEN 0 ELSE [ValueNum] END' />
      </column>
      <column caption='Circles' datatype='string' name='[Calculation_2926776858836455424]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [ValueNum] = 0 THEN NULL else [SP/EF] END' />
      </column>
      <column caption='FundingVal' datatype='integer' name='[Calculation_2926776858838511617]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Round (Support)], [Country (Support)], [NS (Support)] : SUM(IF [Attribute (Support)] = &quot;Total&quot; THEN [Value (Support)] ELSE 0 END) }' />
