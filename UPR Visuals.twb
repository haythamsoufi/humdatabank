              <calculation class='tableau' formula='&quot;AR25&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h6b3a20jfot4w1dzg8wd1y2fpu2'>
            <column datatype='string' name='[Attribute (Support)]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFs&quot;' value='Enabling Functions' />
                <alias key='&quot;Multilateral Support&quot;' value='Through    IFRC' />
                <alias key='&quot;SP1&quot;' value='Climate and environment' />
                <alias key='&quot;SP2&quot;' value='Disasters and crises' />
                <alias key='&quot;SP3&quot;' value='Health and wellbeing' />
                <alias key='&quot;SP4&quot;' value='Migration and displacement' />
                <alias key='&quot;SP5&quot;' value='Values, power and inclusion' />
                <alias key='&quot;Total&quot;' value='Funding Reported' />
              </aliases>
            </column>
            <column caption='Round Filter' datatype='boolean' name='[Calculation_2093329466197032963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Round] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='Colours' datatype='string' name='[Calculation_2264466243873484804]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MAX([Attribute (Support)]) = &quot;Total&quot; THEN&#13;&#10;    &quot;Funding Reported&quot;&#13;&#10;ELSE&#13;&#10;    IF MAX([Value (Support)]) &gt; 0 THEN&#13;&#10;        MIN(IF [Value (Support)] &gt; 0 THEN [Attribute (Support)] END)&#13;&#10;    ELSE&#13;&#10;        NULL&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Support Category' datatype='string' name='[Calculation_2264466243873804293]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Attribute (Support)] = &quot;Multilateral Support&quot; THEN &quot;Multilateral Support&quot; ELSE &quot;Bilateral Support&quot; END' />
            </column>
            <column caption='FundingVal' datatype='integer' name='[Calculation_2926776858838511617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Round (Support)], [Country (Support)], [NS (Support)] : SUM(IF [Attribute (Support)] = &quot;Total&quot; THEN [Value (Support)] ELSE 0 END) }' />
            </column>
            <column caption='Funding Reported' datatype='string' name='[Calculation_2926776858840403970]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_2926776858838511617]) = 0 THEN &quot;&quot;&#13;&#10;ELSEIF SUM([Calculation_2926776858838511617]) &lt; 1000 THEN &#13;&#10;    STR(SUM([Calculation_2926776858838511617]))&#13;&#10;ELSEIF SUM([Calculation_2926776858838511617]) &lt; 1000000 THEN &#13;&#10;    STR(ROUND(SUM([Calculation_2926776858838511617])/1000, 0)) + &quot;,000&quot;&#13;&#10;ELSE &#13;&#10;    IF RIGHT(LEFT(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 2)), FIND(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), &quot;.&quot;) + 1), 2) = &quot;.0&quot; THEN &#13;&#10;        STR(INT(SUM([Calculation_2926776858838511617])/1000000)) + &quot;M&quot;&#13;&#10;    ELSEIF RIGHT(LEFT(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), FIND(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), &quot;.&quot;) + 2), 1) = &quot;0&quot; THEN &#13;&#10;        LEFT(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), FIND(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 2)), &quot;.&quot;) + 1) + &quot;M&quot;&#13;&#10;    ELSE &#13;&#10;        STR(INT(SUM([Calculation_2926776858838511617]) / 1000000)) + &quot;.&quot; + &#13;&#10;        LEFT(STR(INT((SUM([Calculation_2926776858838511617]) - (INT(SUM([Calculation_2926776858838511617]) / 1000000) * 1000000)) / 10000)), 1) + &quot;M&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Country (Support)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[ISO3]' role='dimension' type='nominal' />
            <column caption='National Society' datatype='string' name='[NS (Support)]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Red Crescent Society of the Islamic Republic of Iran&quot;' value='Iranian Red Crescent Society' />
                <alias key='&quot;Red Crescent Society of the United Arab Emirates&quot;' value='United Arab Emirates Red Crescent' />
                <alias key='&quot;Red Cross of Monaco&quot;' value='Monaco Red Cross' />
