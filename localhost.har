rkflowTourParser handle unregistered tours\nif (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', () => {\n        interactiveTour.checkUrlHash(true);\n    });\n} else {\n    interactiveTour.checkUrlHash(true);\n}\n"
