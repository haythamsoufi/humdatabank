# Minimal environment for local development.
# Copy to `Backoffice/.env` and fill in the values you actually need.
#
# Full reference catalog lives in: `Backoffice/env.example`
#
# ----------------------------------------------------------------------------
# App mode (development | staging | production | testing)
FLASK_CONFIG=development

# Sessions/CSRF signing key. Leave empty to get a random key per process (logins reset on restart),
# or generate a stable one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse a development value in staging/production.
SECRET_KEY=

# Database (Postgres required; no SQLite fallback). Local development credentials only; the
# password must match your local Postgres / docker-compose db service.
DATABASE_URL=postgresql+psycopg2://app:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5432/hum_databank

# Optional (recommended): use a separate DB for tests
TEST_DATABASE_URL=postgresql+psycopg2://app:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5432/hum_databank_test

# Frontend URL (for redirects + some CORS defaults)
FRONTEND_URL=http://localhost:3000

# Optional (prod): comma-separated origins to allow CORS
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=

# Optional: Email sender (some flows will warn if unset)
MAIL_DEFAULT_SENDER=

# ----------------------------------------------------------------------------
# Test user passwords (development only)
# These enable quick-login buttons on the login page and set the seeded accounts' passwords.
# Run `flask seed-test-data` after `flask db upgrade` to create the test users. Seeding only runs
# with FLASK_CONFIG=development against a local database.
# Generate one per account:  python -c "import secrets; print(secrets.token_urlsafe(16))"
# Left empty, seeding uses random passwords (use the dev "Act as" buttons to log in).
TEST_ADMIN_PASSWORD=
TEST_FOCAL_PASSWORD=
TEST_SYS_MANAGER_PASSWORD=

# ----------------------------------------------------------------------------
# AI (optional) — keys & env-only secrets only. Tune models and behaviour in
# Admin → System Configuration → AI (database). See env.example AI section.
OPENAI_API_KEY=

# Website anonymous chatbot hardening (optional): same value in Website proxy header.
AI_PUBLIC_PROXY_SECRET=

# ----------------------------------------------------------------------------
# External GO/document API import (optional; AI Documents — uses IFRC_* env names for compatibility)
IFRC_API_USER=
IFRC_API_PASSWORD=

# ----------------------------------------------------------------------------
# Rate limiting — trusted IP bypass (optional).
# Comma-separated IPs that skip all in-process rate limits (CI, load-test runners).
# RATE_LIMIT_EXEMPT_IPS=
