      <table>
        <view>
          <datasources>
            <datasource caption='UPR Master' name='federated.1h6b3a20jfot4w1dzg8wd1y2fpu2' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='RoundParam' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;AR25&quot;'>
              <calculation class='tableau' formula='&quot;AR25&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h6b3a20jfot4w1dzg8wd1y2fpu2'>
            <column datatype='string' name='[Attribute]' role='dimension' type='nominal' />
            <column caption='Value Not reported' datatype='string' name='[Calculation_1797780678625456129]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL(SUM([ValueNum])) THEN &quot;Not reported&quot; else NULL END' />
            </column>
            <column caption='Round Filter' datatype='boolean' name='[Calculation_2093329466197032963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Round] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='Value units' datatype='string' name='[Calculation_418834775635947525]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([ValueNum]) &lt; 1000 THEN&#13;&#10;    STR(SUM([ValueNum]))&#13;&#10;ELSEIF SUM([ValueNum]) &lt; 1000000 THEN&#13;&#10;    STR(ROUND(SUM([ValueNum])/1000,0)) + &quot;,000&quot;&#13;&#10;ELSE&#13;&#10;    IF ROUND(SUM([ValueNum])/1000000,1) == INT(SUM([ValueNum])/1000000) THEN&#13;&#10;        STR(INT(SUM([ValueNum])/1000000)) + &quot;M&quot;&#13;&#10;    ELSE&#13;&#10;        STR(ROUND(SUM([ValueNum])/1000000,1)) + &quot;M&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Funding Attribute' datatype='string' name='[Calculation_418834775993630727]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Attribute]=&quot;Emergency Operations&quot; or [Attribute]=&quot;Longer-term&quot; THEN [Attribute] ELSE &quot;&quot; END' />
            </column>
            <column caption='Funding Filter' datatype='boolean' name='[Calculation_418834775994159112]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT (&#13;&#10;    ([Entity] = &quot;IFRC Secretariat&quot; AND [Attribute] = &quot;Total&quot;) OR&#13;&#10;    ([Entity] = &quot;Country&quot; AND [Indicator] = &quot;Funding&quot;) OR&#13;&#10;    ([Attribute] = &quot;Funding Source&quot; AND [Entity] &lt;&gt; &quot;Other sources&quot;)&#13;&#10;)' />
            </column>
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Entity]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Other sources&quot;' value='HNS other funding sources' />
                <alias key='&quot;PNS&quot;' value='Participating National Societies' />
              </aliases>
            </column>
            <column datatype='string' name='[ISO3]' role='dimension' type='nominal' />
            <column datatype='string' name='[Indicator]' role='dimension' type='nominal'>
