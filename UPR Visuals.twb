            <column caption='Funding Requirement Value' datatype='integer' name='[Calculation_1742611646973620227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Round (Support)], [Country (Support)], [NS (Support)], [Year] : SUM(IF [Attribute (Support)] = &quot;Total&quot; THEN [Value (Support)] ELSE 0 END) }' />
            </column>
            <column caption='Funding Requirement' datatype='string' name='[Calculation_1742611646973833220]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_1742611646973620227]) = 0 THEN &quot;&quot;&#13;&#10;ELSEIF SUM([Calculation_1742611646973620227]) &lt; 1000 THEN&#13;&#10;    STR(SUM([Calculation_1742611646973620227]))&#13;&#10;ELSEIF SUM([Calculation_1742611646973620227]) &lt; 1000000 THEN&#13;&#10;    STR(ROUND(SUM([Calculation_1742611646973620227])/1000,0)) + &quot;,000&quot;&#13;&#10;ELSE&#13;&#10;    IF ROUND(SUM([Calculation_1742611646973620227])/1000000,1) == INT(SUM([Calculation_1742611646973620227])/1000000) THEN&#13;&#10;        STR(INT(SUM([Calculation_1742611646973620227])/1000000)) + &quot;M&quot;&#13;&#10;    ELSE&#13;&#10;        STR(ROUND(SUM([Calculation_1742611646973620227])/1000000,1)) + &quot;M&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Round Filter' datatype='boolean' name='[Calculation_2093329466197032963]' role='dimension' type='nominal'>
