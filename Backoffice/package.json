{
  "name": "ifrc-network-databank",
  "version": "1.0.0",
  "description": "Humanitarian Databank Backoffice",
  "scripts": {
    "build:css": "npx tailwindcss -i ./app/static/css/input.css -o ./app/static/css/output.css --minify -c ./assets/tailwind.config.js",
    "watch:css": "npx tailwindcss -i ./app/static/css/input.css -o ./app/static/css/output.css --watch -c ./assets/tailwind.config.js",
    "vendor:tinymce": "node ./scripts/assets/vendor-tinymce.cjs",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "test:js:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "ag-grid-community": "^34.3.1",
    "exceljs": "^4.4.0",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "postcss-cli": "^11.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^2.1.2",
    "archiver-utils": {
      "brace-expansion": "^1.1.16"
    },
    "rimraf": {
      "brace-expansion": "^1.1.16"
    },
    "zip-stream": {
      "brace-expansion": "^1.1.16"
    },
    "dompurify": "^3.4.12",
    "postcss": "^8.5.18",
    "tmp": "^0.2.6"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.18",
    "tinymce": "^7.9.2",
    "vitest": "^4.1.9"
  }
}
