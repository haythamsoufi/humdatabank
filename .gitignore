Backoffice/translations_base/

# Upload directories
**/uploads/
Backoffice/instance/uploads/

# Archives and exports
Archive/

# Local UPR training docs (PDFs/cases) - keep out of git
UPR training docs/

# Local IFRC reference docs / extracts (not part of the app repo)
IFRC Docs/

# Standalone Indicator Bank app (cloned from Azure DevOps for integration planning)
IFRC.IndicatorBank/

# Local articles / drafts (not part of the app repo)
articles/

# Node logs
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local tool/config files (do not track)
.cursorignore
.dockerignore
.gitattributes
.claude/
# Playwright MCP: keep screenshots/traces under here (see .cursor/mcp.json --output-dir)
.playwright-mcp/

# GitHub metadata (ignore workflows/config)
# Allow .github/workflows/ but ignore other GitHub files
.github/*
!.github/workflows/
!.github/workflows/**/*.yml
!.github/workflows/**/*.yaml
!.github/PULL_REQUEST_TEMPLATE.md
!.github/ISSUE_TEMPLATE/
!.github/dependabot.yml
!.github/ruleset-protect-main.json
!.github/codeql/

# Root helper scripts (local only)
/scripts/

*.docx
*.xlsx
!Backoffice/app/static/templates/*.xlsx
*.toml
# Exceptions — project-level config files that must be committed
!pyproject.toml
!.gitleaks.toml
/*.bat
*.csv
/*.py
/*.ps1
/*.png

# Accidental files
.tmp/
/hell -NoProfile -Command git status -sb
/app.db
*.zip

# Browser HAR captures (may contain session cookies and auth headers)
*.har

# Local prod log extraction scratch space
_prod_logs_temp/

# Local test / probe scratch output
Backoffice/_nav_test.txt
Backoffice/pytest_wds_out.txt
staging_pressure_out.txt

# Windows-specific problematic files
nul
*.nul

MobileApp/android/key.properties

# Emergency Operations plugin — server-side data cache (can be large, regenerated via admin refresh)
Backoffice/plugins/emergency_operations/data/appeals_cache.json
Backoffice/plugins/emergency_operations/data/appeals_cache.tmp

# Azure load test run artifacts (downloaded engine logs, run details, prod webapp dumps)
Backoffice/azure/loadtest/logs/

# Plugin-generated HTML reports (regenerated locally)
Backoffice/plugins/pb_progress/visuals/report/output/*.html
Backoffice/instance/uploads/pb_progress/**/output/*.html