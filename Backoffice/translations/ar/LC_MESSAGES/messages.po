#: app/templates/auth/login.html:3
msgid "Login"
msgstr "تسجيل الدخول"

#: app/templates/auth/login.html:630
msgid "National Societies"
msgstr "جمعيات وطنية"

#: app/templates/auth/login.html:631
msgid "One database"
msgstr "قاعدة بيانات واحدة"

#: app/templates/auth/login.html:637
msgid ""
"This is the consolidated system for unified planning and reporting — with"
" FDRS coming soon."
msgstr ""

#: app/templates/auth/login.html:637
msgid ""
"One place to move away from scattered Excel files, KoBo forms, and "
"multiple logins as workflows are brought together here."
msgstr ""

#: app/templates/auth/login.html:650
msgid "Language"
msgstr "اللغة"

#: app/templates/auth/login.html:678
msgid "Sign in"
msgstr "تسجيل الدخول"

#: app/templates/auth/login.html:679
msgid "Use your National Society or IFRC single sign-on account to continue."
msgstr ""
"استخدم حساب الدخول الموحد الخاص بجمعيتك الوطنية أو الاتحاد الدولي "
"للمتابعة."

#: app/templates/auth/login.html:698
msgid "Continue to sign in"
msgstr "متابعة تسجيل الدخول"

#: app/templates/auth/login.html:707
msgid "New here? You can create your account in the same step."
msgstr "أول مرة هنا؟ يمكنك إنشاء حسابك في نفس الخطوة."

#: app/templates/auth/login.html:714
msgid "Act as (dev only)"
msgstr "تصرف ك (مطور فقط)"

#: app/templates/auth/login.html:716
msgid "Sign in without a password to test as a role preset or any active user."
msgstr "سجل الدخول بدون كلمة مرور لاختبار إعداد دور أو مستخدم نشط."

#: app/templates/auth/login.html:724
msgid "Act as System Manager"
msgstr "العمل كمدير نظام"

#: app/templates/auth/login.html:726
msgid "System Manager"
msgstr "مدير النظام"

#: app/templates/auth/login.html:730
msgid "Act as Admin"
msgstr "العمل كمسؤول"

#: app/templates/auth/login.html:732
msgid "Admin"
msgstr "مدير"

#: app/templates/auth/login.html:736
msgid "Act as Focal Point"
msgstr "العمل كنقطة اتصال"

#: app/templates/auth/login.html:738
msgid "Focal Point"
msgstr "نقطة اتصال"

#: app/templates/auth/login.html:743
msgid "Or choose a user"
msgstr "أو اختر مستخدما"

#: app/templates/auth/login.html:747 app/templates/auth/login.html:1112
msgid "Select a user…"
msgstr "اختر مستخدما..."

#: app/templates/auth/login.html:754
msgid "Please select a user first."
msgstr "يرجى اختيار مستخدم أولا."

#: app/templates/auth/login.html:756
msgid "Signing in…"
msgstr "تسجيل الدخول..."

#: app/templates/auth/login.html:757 app/templates/auth/login.html:759
msgid "Act as selected user"
msgstr "تصرف كمستخدم محدد"

#: app/templates/auth/login.html:767
msgid "Forgot password?"
msgstr "نسيت كلمة المرور؟"

#: app/templates/auth/login.html:769
msgid "Create account"
msgstr "إنشاء حساب"

#: app/templates/auth/login.html:771
msgid "Need help signing in?"
msgstr "هل تحتاج إلى مساعدة لتسجيل الدخول؟"

#: app/templates/auth/login.html:782 app/templates/auth/login.html:827
msgid "Close"
msgstr "إغلاق"

#: app/templates/auth/login.html:783
msgid "Create your account"
msgstr "سجل الدخول إلى حسابك"

#: app/templates/auth/login.html:786 app/templates/auth/login.html:832
msgid "Email"
msgstr "البريد الإلكتروني"

#: app/templates/auth/login.html:789
msgid "Name (optional)"
msgstr "ملاحظة النسخة (اختياري)"

#: app/templates/auth/login.html:791
msgid "Title (optional)"
msgstr "ملاحظة النسخة (اختياري)"

#: app/templates/auth/login.html:794
msgid "Country you will cover"
msgstr "البلد الذي ستغطيه"

#: app/templates/auth/login.html:797
msgid ""
"Select one country you request access to. An admin will review your "
"request."
msgstr "حدد البلد الذي تحتاج الوصول إليه. سيقوم المسؤول بمراجعة طلبك."

#: app/templates/auth/login.html:800
msgid "Message to admins (optional)"
msgstr "رسالة للمسؤولين"

#: app/templates/auth/login.html:801
msgid "Briefly describe your role and why you need access"
msgstr "اوصف بإيجاز دورك ولماذا تحتاج الوصول"

#: app/templates/auth/login.html:805
msgid "Password"
msgstr "كلمة المرور"

#: app/templates/auth/login.html:809
msgid "At least 8 characters"
msgstr "الربع الأخير"

#: app/templates/auth/login.html:810
msgid "Contains an uppercase letter"
msgstr "يحتوي على حرف كبير"

#: app/templates/auth/login.html:811
msgid "Contains a lowercase letter"
msgstr "يحتوي على حرف صغير"

#: app/templates/auth/login.html:812
msgid "Contains a number"
msgstr "استمر"

#: app/templates/auth/login.html:813
msgid "Contains a special character (e.g. !@#$)"
msgstr "يحتوي على حرف خاص (مثلا !@#$)"

#: app/templates/auth/login.html:817
msgid "Confirm Password"
msgstr "نسيت كلمة المرور؟"

#: app/templates/auth/login.html:820
msgid "Create Account"
msgstr "تم الإنشاء في"

#: app/templates/auth/login.html:820
msgid "Creating account…"
msgstr "إنشاء حساب..."

#: app/templates/auth/login.html:828
msgid "Forgot your password?"
msgstr "نسيت كلمة المرور؟"

#: app/templates/auth/login.html:829
msgid "Enter your email and we'll send you a link to reset your password."
msgstr "أدخل بريدك الإلكتروني وسنرسل لك رابطا لإعادة تعيين كلمة المرور."

#: app/templates/auth/login.html:834
msgid "Send Reset Link"
msgstr "رابط إعادة الإرسال"

#: app/templates/auth/login.html:834
msgid "Sending…"
msgstr "أرسل..."

#: app/templates/auth/login.html:871
msgid "Welcome to the"
msgstr "مرحبا بك في"

#: app/templates/auth/login.html:1178
msgid "Select a country"
msgstr "اختر بلداً"

#: app/templates/auth/login.html:1228
msgid "Passwords match"
msgstr "كلمة المرور"

#: app/templates/auth/login.html:1228
msgid "Passwords do not match"
msgstr "كلمات المرور لا تتطابق"

#: app/templates/auth/login.html:1247
msgid "Please enter a valid email address"
msgstr "يرجى إدخال بريد إلكتروني صالح"

#: app/templates/auth/login.html:1255 app/templates/auth/login.html:1268
msgid "This email is already registered. Try signing in or reset your password."
msgstr ""
"هذا البريد الإلكتروني مسجل بالفعل. حاول تسجيل الدخول أو إعادة تعيين كلمة "
"المرور."

#: app/templates/auth/login.html:1256
msgid "Great! This email is available."
msgstr "رائع! هذا البريد الإلكتروني متاح."

