        <calculation class='tableau' formula='SUM(&#13;&#10;    {FIXED [Country], [Calculation_418834775604527104], [Calculation_418834775605768195]: &#13;&#10;        MAX(IF [unitOfMeasurement] = &quot;People&quot; AND [typeOfMeasurement] = &quot;Number&quot; AND [Attribute] = &quot;Total&quot; THEN [ValueNum] END)&#13;&#10;    }&#13;&#10;)' />
