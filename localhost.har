            "mimeType": "text/css",
            "text": "/* Shared Excel import/export UI — dropzone, modals, cards */\n\n/* ── Dropzone ─────────────────────────────────────────────────────────── */\n\n.excel-io-dropzone {\n    position: relative;\n    min-height: 10rem;\n    border: 2px dashed #d1d5db;\n    border-radius: 0.5rem;\n    background: #fafafa;\n    transition: border-color 0.15s ease, background-color 0.15s ease;\n}\n\n.excel-io-dropzone--kobo:hover {\n    border-color: #fbbf24;\n}\n\n.excel-io-dropzone--excel:hover,\n.excel-io-dropzone:not(.excel-io-dropzone--kobo):not(.excel-io-dropzone--neutral):hover {\n    border-color: #86efac;\n}\n\n.excel-io-dropzone--neutral:hover {\n    border-color: #93c5fd;\n}\n\n.excel-io-dropzone--active {\n    border-color: #3b82f6;\n    background: #eff6ff;\n}\n\n.excel-io-dropzone--active-kobo {\n    border-color: #d97706;\n    background: #fffbeb;\n}\n\n.excel-io-dropzone--active-neutral {\n    border-color: #2563eb;\n    background: #eff6ff;\n}\n\n.excel-io-file-input {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    opacity: 0;\n    cursor: pointer;\n    z-index: 10;\n}\n\n/* After a file is chosen, keep the input off the validation panel so errors can scroll */\n.excel-io-dropzone--has-file .excel-io-file-input {\n    pointer-events: none;\n}\n\n.excel-io-dropzone--has-file .excel-io-dropzone__content--selected {\n    position: relative;\n    z-index: 11;\n    pointer-events: none;\n}\n\n.excel-io-dropzone--has-file .excel-io-dropzone__file-panel,\n.excel-io-dropzone--has-file .excel-io-dropzone__status {\n    pointer-events: auto;\n}\n\n.excel-io-dropzone--has-file .excel-io-dropzone__file-panel {\n    cursor: pointer;\n}\n\n.excel-io-dropzone--has-file .excel-io-dropzone__status {\n    cursor: default;\n    position: relative;\n    z-index: 12;\n}\n\n.excel-io-dropzone--has-file .excel-io-dropzone__status:not(:empty) {\n    overflow-x: hidden;\n    overflow-y: auto;\n    overscroll-behavior: contain;\n    -webkit-overflow-scrolling: touch;\n}\n\n.excel-io-dropzone__overlay {\n    position: absolute;\n    inset: 0;\n    z-index: 20;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    background: rgba(255, 255, 255, 0.92);\n    pointer-events: none;\n}\n\n.excel-io-dropzone__overlay[hidden] {\n    display: none !important;\n}\n\n.excel-io-dropzone__content {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    min-height: 10rem;\n    padding: 1.5rem;\n    text-align: center;\n    pointer-events: none;\n}\n\n.excel-io-dropzone__content[hidden] {\n    display: none !important;\n}\n\n.excel-io-dropzone__content--selected {\n    flex-direction: row;\n    align-items: center;\n    gap: 0;\n    min-height: 8rem;\n    padding: 1.25rem 1.5rem;\n    text-align: left;\n}\n\n.excel-io-dropzone__file-panel {\n    flex: 1 1 50%;\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    justify-content: center;\n    min-width: 0;\n    padding-right: 1.5rem;\n}\n\n.excel-io-dropzone__divider {\n    flex: 0 0 auto;\n    align-self: stretch;\n    width: 0;\n    border-left: 1px dotted #d1d5db;\n}\n\n.excel-io-dropzone__content--selected:not(:has(.excel-io-dropzone__status:not(:empty))) .excel-io-dropzone__divider {\n    display: none;\n}\n\n.excel-io-dropzone__content--selected:not(:has(.excel-io-dropzone__status:not(:empty))) .excel-io-dropzone__file-panel {\n    flex: 1 1 100%;\n    padding-right: 0;\n}\n\n.excel-io-dropzone--has-file {\n    border-style: solid;\n    border-color: #e5e7eb;\n    background: #fff;\n}\n\n.excel-io-dropzone__file-icon {\n    font-size: 1.25rem;\n    margin: 0 0 0.5rem;\n    color: #6b7280;\n}\n\n.excel-io-dropzone--excel .excel-io-dropzone__file-icon {\n    color: #059669;\n}\n\n.excel-io-dropzone--kobo .excel-io-dropzone__file-icon {\n    color: #b45309;\n}\n\n.excel-io-dropzone__filename {\n    font-size: 0.875rem;\n    font-weight: 600;\n    color: #111827;\n    margin: 0;\n    max-width: 100%;\n    line-height: 1.4;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n    word-break: break-word;\n}\n\n.excel-io-dropzone__change-hint {\n    font-size: 0.75rem;\n    color: #9ca3af;\n    margin: 0.375rem 0 0;\n}\n\n.excel-io-dropzone__status {\n    flex: 1 1 50%;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    min-width: 0;\n    padding-left: 1.5rem;\n}\n\n.excel-io-dropzone__status:empty {\n    display: none;\n}\n\n.excel-io-dropzone__preview {\n    display: flex;\n    flex-direction: column;\n    gap: 0.375rem;\n    width: 100%;\n}\n\n.excel-io-dropzone__preview-heading {\n    margin: 0 0 0.125rem;\n    font-size: 0.6875rem;\n    font-weight: 600;\n    letter-spacing: 0.05em;\n    text-transform: uppercase;\n    color: #9ca3af;\n}\n\n.excel-io-dropzone__preview-line {\n    display: flex;\n    align-items: flex-start;\n    gap: 0.5rem;\n    margin: 0;\n    font-size: 0.8125rem;\n    line-height: 1.5;\n    color: #374151;\n}\n\n.excel-io-dropzone__preview-line i {\n    flex-shrink: 0;\n    width: 0.875rem;\n    margin: 0.2rem 0 0;\n    font-size: 0.8125rem;\n    text-align: center;\n}\n\n.excel-io-dropzone__preview-line--success {\n    font-weight: 500;\n    color: #111827;\n}\n\n.excel-io-dropzone__preview-line--success i {\n    color: #059669;\n}\n\n.excel-io-dropzone__preview-line--pending i {\n    color: #6b7280;\n}\n\n.excel-io-dropzone__preview-line--error {\n    color: #991b1b;\n}\n\n.excel-io-dropzone__preview-line--error i {\n    color: #dc2626;\n}\n\n.excel-io-dropzone__preview-line--name {\n    flex-direction: column;\n    gap: 0.125rem;\n    margin-top: 0.125rem;\n}\n\n.excel-io-dropzone__preview-meta-label {\n    font-size: 0.75rem;\n    font-weight: 500;\n    color: #6b7280;\n}\n\n.excel-io-dropzone__preview-meta-value {\n    font-size: 0.8125rem;\n    font-weight: 500;\n    color: #111827;\n    word-break: break-word;\n}\n\n.excel-io-dropzone__preview-errors {\n    margin: 0.125rem 0 0 1.375rem;\n    padding: 0;\n    font-size: 0.75rem;\n    line-height: 1.45;\n    color: #991b1b;\n    overflow-wrap: anywhere;\n    word-break: break-word;\n}\n\n.excel-io-dropzone__preview-errors li + li {\n    margin-top: 0.25rem;\n}\n\n.excel-io-dropzone__preview-detail {\n    margin: 0.375rem 0 0 1.375rem;\n    font-size: 0.75rem;\n    line-height: 1.45;\n    color: #991b1b;\n    overflow-wrap: anywhere;\n    word-break: break-word;\n}\n\n/* Long validation output — stack and scroll instead of stretching the modal/page */\n.excel-io-dropzone--has-file.excel-io-dropzone--invalid {\n    max-height: min(52vh, 22rem);\n    overflow: hidden;\n}\n\n.excel-io-dropzone--invalid .excel-io-dropzone__content--selected {\n    flex-direction: column;\n    align-items: stretch;\n    min-height: 0;\n    height: 100%;\n    max-height: min(52vh, 22rem);\n    overflow: hidden;\n    padding: 1rem 1.25rem;\n}\n\n.excel-io-dropzone--invalid .excel-io-dropzone__file-panel {\n    flex: 0 0 auto;\n    padding-right: 0;\n    padding-bottom: 0.75rem;\n}\n\n.excel-io-dropzone--invalid .excel-io-dropzone__divider {\n    flex: 0 0 auto;\n    width: auto;\n    height: 0;\n    align-self: stretch;\n    border-left: none;\n    border-top: 1px dotted #d1d5db;\n}\n\n.excel-io-dropzone--invalid .excel-io-dropzone__status {\n    flex: 1 1 auto;\n    min-height: 0;\n    overflow-x: hidden;\n    overflow-y: auto;\n    padding-left: 0;\n    padding-top: 0;\n    justify-content: flex-start;\n    overscroll-behavior: contain;\n}\n\n.excel-io-dropzone--invalid .excel-io-dropzone__preview-line {\n    overflow-wrap: anywhere;\n    word-break: break-word;\n}\n\n/* Keep excel import/export modals within the viewport when content grows */\n.modal-shell-content:has(.excel-io-modal--simple) .modal-content,\n.modal-shell-content:has(.excel-io-modal--tabs) .modal-content,\n.modal-shell-content:has(.excel-io-modal--split) .modal-content {\n    max-height: min(78vh, 42rem);\n    overflow-y: auto;\n    overscroll-behavior: contain;\n}\n\n@media (max-width: 640px) {\n    .excel-io-dropzone__content--selected {\n        flex-direction: column;\n        align-items: stretch;\n        padding: 1rem;\n    }\n\n    .excel-io-dropzone__file-panel {\n        padding-right: 0;\n        padding-bottom: 1rem;\n    }\n\n    .excel-io-dropzone__divider {\n        width: auto;\n        height: 0;\n        border-left: none;\n        border-top: 1px dotted #d1d5db;\n    }\n\n    .excel-io-dropzone__status {\n        padding-left: 0;\n        padding-top: 1rem;\n    }\n}\n\n.excel-io-dropzone__content--empty i {\n    font-size: 2rem;\n    color: #9ca3af;\n    margin-bottom: 0.5rem;\n}\n\n.excel-io-dropzone__title {\n    font-size: 0.875rem;\n    color: #4b5563;\n    margin: 0 0 0.25rem;\n}\n\n.excel-io-dropzone__hint {\n    font-size: 0.75rem;\n    color: #9ca3af;\n    margin: 0;\n}\n\n.excel-io-dropzone--validating {\n    border-color: #93c5fd;\n}\n\n.excel-io-dropzone--valid {\n    border-color: #6ee7b7;\n}\n\n.excel-io-dropzone--invalid {\n    border-color: #fca5a5;\n}\n\n/* Legacy alias during migration */\n.file-upload-wrapper.excel-io-dropzone-legacy,\n.excel-io-dropzone.file-upload-wrapper {\n    /* combined usage ok */\n}\n\n/* ── Modal layouts ────────────────────────────────────────────────────── */\n\n.excel-io-modal--simple {\n    display: flex;\n    flex-direction: column;\n    gap: 1rem;\n}\n\n.excel-io-modal--split {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 0;\n    width: 100%;\n}\n\n@media (min-width: 768px) {\n    .excel-io-modal--split {\n        grid-template-columns: 1fr 1fr;\n    }\n\n    .excel-io-modal--split .excel-io-modal__col--export {\n        border-right: 1px solid #e5e7eb;\n    }\n}\n\n.excel-io-modal--split .excel-io-modal__col {\n    padding: 1.5rem;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 1rem;\n}\n\n.excel-io-modal--split .excel-io-modal__col .excel-io-dropzone {\n    flex: 1;\n    min-height: 11rem;\n}\n\n.excel-io-modal__btn-row {\n    display: flex;\n    flex-direction: column;\n    gap: 0.5rem;\n}\n\n.excel-io-modal__btn-row .excel-io-modal__btn,\n.excel-io-modal__btn-row .btn {\n    width: 100%;\n}\n\n.excel-io-modal--split.excel-io-modal--import-only .excel-io-modal__col--export,\n.excel-io-modal--split.excel-io-modal--export-only .excel-io-modal__col--import {\n    display: none;\n}\n\n.excel-io-modal__section-title {\n    font-size: 1.125rem;\n    font-weight: 500;\n    color: #374151;\n    margin: 0 0 1rem;\n}\n\n.excel-io-modal__note {\n    margin-top: 0.5rem;\n    font-size: 0.75rem;\n    color: #6b7280;\n}\n\n.excel-io-modal__note i {\n    margin-right: 0.25rem;\n}\n\n/* Tabs layout */\n.excel-io-modal--tabs .excel-io-tabs {\n    margin-bottom: 1rem;\n}\n\n.excel-io-modal--tabs .excel-io-tab-panel[hidden] {\n    display: none !important;\n}\n\n.excel-io-tabs__bar {\n    display: flex;\n    gap: 2rem;\n    border-bottom: 1px solid #e5e7eb;\n    margin-bottom: 1rem;\n}\n\n.excel-io-tabs__btn {\n    white-space: nowrap;\n    padding: 1rem 0.25rem;\n    border-bottom: 2px solid transparent;\n    font-size: 0.875rem;\n    font-weight: 500;\n    color: #6b7280;\n    background: none;\n    border-top: none;\n    border-left: none;\n    border-right: none;\n    cursor: pointer;\n}\n\n.excel-io-tabs__btn:hover {\n    color: #374151;\n    border-bottom-color: #d1d5db;\n}\n\n.excel-io-tabs__btn--active {\n    color: #2563eb;\n    border-bottom-color: #2563eb;\n}\n\n.excel-io-card {\n    border: 1px solid #e5e7eb;\n    border-radius: 0.5rem;\n    padding: 1rem;\n}\n\n.excel-io-card__title {\n    font-size: 1.125rem;\n    font-weight: 600;\n    color: #111827;\n    margin: 0 0 0.5rem;\n    display: flex;\n    align-items: center;\n}\n\n.excel-io-card__title i {\n    margin-right: 0.5rem;\n}\n\n.excel-io-card__desc {\n    font-size: 0.875rem;\n    color: #4b5563;\n    margin: 0 0 1rem;\n}\n\n.excel-io-toolbar {\n    margin-bottom: 1.5rem;\n    padding: 1rem;\n    background: #f9fafb;\n    border: 1px solid #e5e7eb;\n    border-radius: 0.5rem;\n}\n\n.excel-io-toolbar__inner {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 1rem;\n}\n\n.excel-io-toolbar__actions {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.75rem;\n}\n\n.excel-io-review-modal__body {\n    max-height: 60vh;\n    overflow-y: auto;\n}\n\n.excel-io-review-modal__footer {\n    display: flex;\n    justify-content: flex-end;\n    gap: 0.75rem;\n    padding-top: 0.75rem;\n    border-top: 1px solid #e5e7eb;\n    background: #f9fafb;\n    border-radius: 0 0 0.5rem 0.5rem;\n}\n"
