              <calculation class='tableau' formula='&quot;AR25&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1h6b3a20jfot4w1dzg8wd1y2fpu2'>
            <column datatype='string' name='[Attribute (Support)]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;EFs&quot;' value='Enabling Functions' />
                <alias key='&quot;Multilateral Support&quot;' value='Through    IFRC' />
                <alias key='&quot;SP1&quot;' value='Climate and environment' />
                <alias key='&quot;SP2&quot;' value='Disasters and crises' />
                <alias key='&quot;SP3&quot;' value='Health and wellbeing' />
                <alias key='&quot;SP4&quot;' value='Migration and displacement' />
                <alias key='&quot;SP5&quot;' value='Values, power and inclusion' />
                <alias key='&quot;Total&quot;' value='Funding Reported' />
              </aliases>
            </column>
            <column datatype='string' name='[Attribute]' role='dimension' type='nominal' />
            <column datatype='string' name='[Bundle]' role='dimension' type='nominal' />
            <column caption='Funding Requirement Value' datatype='integer' name='[Calculation_1742611646973620227]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Round (Support)], [Country (Support)], [NS (Support)], [Year] : SUM(IF [Attribute (Support)] = &quot;Total&quot; THEN [Value (Support)] ELSE 0 END) }' />
            </column>
            <column caption='Funding Requirement' datatype='string' name='[Calculation_1742611646973833220]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_1742611646973620227]) = 0 THEN &quot;&quot;&#13;&#10;ELSEIF SUM([Calculation_1742611646973620227]) &lt; 1000 THEN&#13;&#10;    STR(SUM([Calculation_1742611646973620227]))&#13;&#10;ELSEIF SUM([Calculation_1742611646973620227]) &lt; 1000000 THEN&#13;&#10;    STR(ROUND(SUM([Calculation_1742611646973620227])/1000,0)) + &quot;,000&quot;&#13;&#10;ELSE&#13;&#10;    IF ROUND(SUM([Calculation_1742611646973620227])/1000000,1) == INT(SUM([Calculation_1742611646973620227])/1000000) THEN&#13;&#10;        STR(INT(SUM([Calculation_1742611646973620227])/1000000)) + &quot;M&quot;&#13;&#10;    ELSE&#13;&#10;        STR(ROUND(SUM([Calculation_1742611646973620227])/1000000,1)) + &quot;M&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Round Filter' datatype='boolean' name='[Calculation_2093329466197032963]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Round] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='Colours' datatype='string' name='[Calculation_2264466243873484804]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MAX([Attribute (Support)]) = &quot;Total&quot; THEN&#13;&#10;    &quot;Funding Reported&quot;&#13;&#10;ELSE&#13;&#10;    IF MAX([Value (Support)]) &gt; 0 THEN&#13;&#10;        MIN(IF [Value (Support)] &gt; 0 THEN [Attribute (Support)] END)&#13;&#10;    ELSE&#13;&#10;        NULL&#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='FundingVal' datatype='integer' name='[Calculation_2926776858838511617]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Round (Support)], [Country (Support)], [NS (Support)] : SUM(IF [Attribute (Support)] = &quot;Total&quot; THEN [Value (Support)] ELSE 0 END) }' />
            </column>
            <column caption='Support' datatype='string' name='[Calculation_418834775637114886]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;    SUM(IF [Attribute] = &quot;Planned&quot; THEN 1 ELSE 0 END) &gt; 0 &#13;&#10;    AND &#13;&#10;    SUM(IF [Attribute] = &quot;Supported&quot; THEN 1 ELSE 0 END) &gt; 0 &#13;&#10;THEN &#13;&#10;    &quot;Supported&quot;&#13;&#10;ELSEIF &#13;&#10;    SUM(IF [Attribute] = &quot;Supported&quot; THEN 1 ELSE 0 END) &gt; 0 &#13;&#10;    AND &#13;&#10;    SUM(IF [Attribute] = &quot;Planned&quot; THEN 1 ELSE 0 END) = 0 &#13;&#10;THEN &#13;&#10;    &quot;Supported&quot;&#13;&#10;ELSEIF &#13;&#10;    SUM(IF [Attribute] = &quot;Planned&quot; THEN 1 ELSE 0 END) &gt; 0 &#13;&#10;    AND &#13;&#10;    SUM(IF [Attribute] = &quot;Supported&quot; THEN 1 ELSE 0 END) = 0 &#13;&#10;THEN &#13;&#10;    &quot;Planned&quot;&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='Support value text' datatype='string' name='[Calculation_996702897439354883]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Value (Support)]) = 1 THEN &quot;-&quot; ELSE &#13;&#10;&#13;&#10;IF SUM([Value (Support)]) = 0 THEN &quot;&quot;&#13;&#10;ELSEIF SUM([Value (Support)]) &lt; 1000 THEN &#13;&#10;    STR(SUM([Value (Support)]))&#13;&#10;ELSEIF SUM([Value (Support)]) &lt; 1000000 THEN &#13;&#10;    STR(ROUND(SUM([Value (Support)])/1000, 0)) + &quot;,000&quot;&#13;&#10;ELSE &#13;&#10;    IF RIGHT(LEFT(STR(ROUND(SUM([Value (Support)])/1000000, 2)), FIND(STR(ROUND(SUM([Value (Support)])/1000000, 1)), &quot;.&quot;) + 1), 2) = &quot;.0&quot; THEN &#13;&#10;        STR(INT(SUM([Value (Support)])/1000000)) + &quot;M&quot;&#13;&#10;    ELSEIF RIGHT(LEFT(STR(ROUND(SUM([Value (Support)])/1000000, 1)), FIND(STR(ROUND(SUM([Value (Support)])/1000000, 1)), &quot;.&quot;) + 2), 1) = &quot;0&quot; THEN &#13;&#10;        LEFT(STR(ROUND(SUM([Value (Support)])/1000000, 1)), FIND(STR(ROUND(SUM([Value (Support)])/1000000, 2)), &quot;.&quot;) + 1) + &quot;M&quot;&#13;&#10;    ELSE &#13;&#10;        STR(INT(SUM([Value (Support)]) / 1000000)) + &quot;.&quot; + &#13;&#10;        LEFT(STR(INT((SUM([Value (Support)]) - (INT(SUM([Value (Support)]) / 1000000) * 1000000)) / 10000)), 1) + &quot;M&quot;&#13;&#10;    END&#13;&#10;END&#13;&#10;&#13;&#10; END' />
            </column>
            <column datatype='string' name='[Country (Support)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Confirmed Funding' datatype='string' name='[Funding Requirement (copy)_996702897372520449]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Funding Requirement Value (copy)_996702897372332032]) = 0 THEN &quot;&quot;&#13;&#10;ELSEIF SUM([Funding Requirement Value (copy)_996702897372332032]) &lt; 1000 THEN&#13;&#10;    STR(SUM([Funding Requirement Value (copy)_996702897372332032]))&#13;&#10;ELSEIF SUM([Funding Requirement Value (copy)_996702897372332032]) &lt; 1000000 THEN&#13;&#10;    STR(ROUND(SUM([Funding Requirement Value (copy)_996702897372332032])/1000,0)) + &quot;,000&quot;&#13;&#10;ELSE&#13;&#10;    IF ROUND(SUM([Funding Requirement Value (copy)_996702897372332032])/1000000,1) == INT(SUM([Funding Requirement Value (copy)_996702897372332032])/1000000) THEN&#13;&#10;        STR(INT(SUM([Funding Requirement Value (copy)_996702897372332032])/1000000)) + &quot;M&quot;&#13;&#10;    ELSE&#13;&#10;        STR(ROUND(SUM([Funding Requirement Value (copy)_996702897372332032])/1000000,1)) + &quot;M&quot;&#13;&#10;    END&#13;&#10;END' />
            </column>
