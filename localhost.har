125rem;\n  color: rgba(255, 255, 255, 0.88);\n  transition: color var(--fab-hover-duration, 0.2s) ease, transform 0.3s ease;\n}\n\n#chatbot-ai-hover-menu .fab-hover-pill-label {\n  position: relative;\n  z-index: 1;\n  font-size: 12px;\n  font-weight: 500;\n  letter-spacing: 0.01em;\n  color: rgba(241, 245, 249, 0.78);\n  transition: color var(--fab-hover-duration, 0.2s) ease;\n}\n\n#chatbot-ai-hover-menu .fab-hover-pill:hover {\n  transform: translateY(-2px);\n  background: #131316;\n  border-color: rgba(220, 38, 38, 0.3);\n  box-shadow:\n    0 0 0 1px rgba(0, 0, 0, 0.12) inset,\n    0 2px 6px rgba(0, 0, 0, 0.45),\n    0 8px 20px rgba(0, 0, 0, 0.32),\n    0 0 24px rgba(185, 28, 28, 0.14);\n}\n\n#chatbot-ai-hover-menu .fab-hover-pill:hover .fab-hover-pill-icon {\n  transform: none;\n}\n\n#chatbot-ai-hover-menu .fab-hover-pill:hover .fab-hover-pill-icon i {\n  color: #ffffff;\n  transform: scale(1.05);\n}\n\n#chatbot-ai-hover-menu .fab-hover-pill:hover .fab-hover-pill-label {\n  color: #f1f5f9;\n}\n\n#chatbot-ai-hover-menu .fab-hover-pill:focus-visible {\n  outline: none;\n  box-shadow:\n    0 0 0 2px #0c0c0e,\n    0 0 0 4px rgba(220, 38, 38, 0.55),\n    0 6px 18px rgba(0, 0, 0, 0.3);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  #fab-menu,\n  #fab-menu button,\n  #chatbot-ai-hover-menu,\n  #chatbot-ai-hover-menu .chatbot-ai-hover-row,\n  #chatbot-ai-hover-menu .fab-hover-pill {\n    transition-duration: 0.01ms !important;\n    transition-delay: 0ms !important;\n  }\n\n  #fab-menu button,\n  #chatbot-ai-hover-menu .chatbot-ai-hover-row {\n    transform: none !important;\n  }\n}\n"
