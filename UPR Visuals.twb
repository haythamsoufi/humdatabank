              <calculation class='tableau' formula='{ FIXED [Round (Support)], [Country (Support)], [NS (Support)], [Year] : SUM(IF [Attribute (Support)] = &quot;Confirmed Funding&quot; THEN [Value (Support)] ELSE 0 END) }' />
