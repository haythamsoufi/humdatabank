            <column caption='PNS Table (Funding)' datatype='string' name='[PNS Table final (copy)_1541638503754018821]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF MIN([Attribute (Support)]) = &quot;Total&quot; THEN&#13;&#10;    IF SUM([Calculation_2926776858838511617]) = 0 THEN &quot;&quot;&#13;&#10;    ELSEIF SUM([Calculation_2926776858838511617]) &lt; 1000 THEN &#13;&#10;        STR(SUM([Calculation_2926776858838511617]))&#13;&#10;    ELSEIF SUM([Calculation_2926776858838511617]) &lt; 1000000 THEN &#13;&#10;        STR(ROUND(SUM([Calculation_2926776858838511617])/1000, 0)) + &quot;,000&quot;&#13;&#10;    ELSE &#13;&#10;        IF RIGHT(LEFT(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), FIND(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), &quot;.&quot;) + 1), 2) = &quot;.0&quot; THEN &#13;&#10;            STR(INT(SUM([Calculation_2926776858838511617])/1000000)) + &quot;M&quot;&#13;&#10;        ELSEIF RIGHT(LEFT(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), FIND(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), &quot;.&quot;) + 2), 1) = &quot;0&quot; THEN &#13;&#10;            LEFT(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), FIND(STR(ROUND(SUM([Calculation_2926776858838511617])/1000000, 1)), &quot;.&quot;) + 1) + &quot;M&quot;&#13;&#10;        ELSE &#13;&#10;            STR(INT(SUM([Calculation_2926776858838511617]) / 1000000)) + &quot;.&quot; + &#13;&#10;            LEFT(STR(INT((SUM([Calculation_2926776858838511617]) - (INT(SUM([Calculation_2926776858838511617]) / 1000000) * 1000000)) / 10000)), 1) + &quot;M&quot;&#13;&#10;        END&#13;&#10;    END&#13;&#10;ELSE Null END' />
