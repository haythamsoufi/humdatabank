      <column caption='Reach calc' datatype='string' name='[Calculation_418834775605768195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Section] = &quot;Emergency 1&quot; or [Section] = &quot;Emergency 2&quot; or [Section] = &quot;Emergency 3&quot; THEN [Section]&#13;&#10;ELSE [Area] END' />
      </column>
      <column caption='Label_Indicators' datatype='string' name='[Calculation_418834775609376772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [unitOfMeasurement] = &quot;Yes/No&quot; AND [ValueNum] = 1 THEN &#13;&#10;    &quot;Yes&quot;&#13;&#10;ELSEIF [unitOfMeasurement] = &quot;Percentage&quot; AND [ValueNum] &lt; 1 THEN &#13;&#10;    STR(ROUND([ValueNum] * 100, 0)) + &quot;%&quot;&#13;&#10;ELSEIF [unitOfMeasurement] = &quot;Percentage&quot; THEN &#13;&#10;    STR(ROUND([ValueNum], 0)) + &quot;%&quot;&#13;&#10;ELSEIF [ValueNum] &lt; 1000 THEN &#13;&#10;    STR([ValueNum])&#13;&#10;ELSEIF [ValueNum] &lt; 1000000 THEN &#13;&#10;    STR(ROUND([ValueNum]/1000, 0)) + &quot;,000&quot;&#13;&#10;ELSE &#13;&#10;    IF RIGHT(LEFT(STR(ROUND([ValueNum]/1000000, 1)), FIND(STR(ROUND([ValueNum]/1000000, 1)), &quot;.&quot;) + 1), 2) = &quot;.0&quot; THEN &#13;&#10;        STR(INT([ValueNum]/1000000)) + &quot;M&quot;&#13;&#10;    ELSEIF RIGHT(LEFT(STR(ROUND([ValueNum]/1000000, 1)), FIND(STR(ROUND([ValueNum]/1000000, 1)), &quot;.&quot;) + 2), 1) = &quot;0&quot; THEN &#13;&#10;        LEFT(STR(ROUND([ValueNum]/1000000, 1)), FIND(STR(ROUND([ValueNum]/1000000, 1)), &quot;.&quot;) + 1) + &quot;M&quot;&#13;&#10;    ELSE &#13;&#10;        STR(INT([ValueNum] / 1000000)) + &quot;.&quot; + &#13;&#10;        LEFT(STR(INT(([ValueNum] - (INT([ValueNum] / 1000000) * 1000000)) / 10000)), 1) + &quot;M&quot;&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='Value units' datatype='string' name='[Calculation_418834775635947525]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([ValueNum]) &lt; 1000 THEN&#13;&#10;    STR(SUM([ValueNum]))&#13;&#10;ELSEIF SUM([ValueNum]) &lt; 1000000 THEN&#13;&#10;    STR(ROUND(SUM([ValueNum])/1000,0)) + &quot;,000&quot;&#13;&#10;ELSE&#13;&#10;    IF ROUND(SUM([ValueNum])/1000000,1) == INT(SUM([ValueNum])/1000000) THEN&#13;&#10;        STR(INT(SUM([ValueNum])/1000000)) + &quot;M&quot;&#13;&#10;    ELSE&#13;&#10;        STR(ROUND(SUM([ValueNum])/1000000,1)) + &quot;M&quot;&#13;&#10;    END&#13;&#10;END' />
      </column>
      <column caption='Support' datatype='string' name='[Calculation_418834775637114886]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;    SUM(IF [Attribute] = &quot;Planned&quot; THEN 1 ELSE 0 END) &gt; 0 &#13;&#10;    AND &#13;&#10;    SUM(IF [Attribute] = &quot;Supported&quot; THEN 1 ELSE 0 END) &gt; 0 &#13;&#10;THEN &#13;&#10;    &quot;Supported&quot;&#13;&#10;ELSEIF &#13;&#10;    SUM(IF [Attribute] = &quot;Supported&quot; THEN 1 ELSE 0 END) &gt; 0 &#13;&#10;    AND &#13;&#10;    SUM(IF [Attribute] = &quot;Planned&quot; THEN 1 ELSE 0 END) = 0 &#13;&#10;THEN &#13;&#10;    &quot;Supported&quot;&#13;&#10;ELSEIF &#13;&#10;    SUM(IF [Attribute] = &quot;Planned&quot; THEN 1 ELSE 0 END) &gt; 0 &#13;&#10;    AND &#13;&#10;    SUM(IF [Attribute] = &quot;Supported&quot; THEN 1 ELSE 0 END) = 0 &#13;&#10;THEN &#13;&#10;    &quot;Planned&quot;&#13;&#10;ELSE &#13;&#10;    NULL&#13;&#10;END' />
      </column>
